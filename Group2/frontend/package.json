{
  "name": "shopping-cart-frontend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "ng serve --host 127.0.0.1 --port 4200 --proxy-config proxy.conf.json",
    "check": "ngc -p tsconfig.app.json --noEmit && ngc -p tsconfig.spec.json --noEmit",
    "test": "ng test --watch=false",
    "build": "ng build --configuration production --base-href=/products/",
    "deploy": "npm run check && npm run test && npm run build && node scripts/deploy.mjs"
  },
  "dependencies": {
    "@angular/common": "22.2.1",
    "@angular/compiler": "22.2.1",
    "@angular/core": "22.2.1",
    "@angular/platform-browser": "22.2.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "22.2.1",
    "@angular/cli": "22.2.1",
    "@angular/compiler-cli": "22.2.1",
    "jsdom": "^30.0.0",
    "typescript": "~6.0.2",
    "vitest": "^5.0.0"
  }
}